{
  "name": "openawa-frontend",
  "version": "0.06",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8000/openapi.json -o src/shared/api/schema.d.ts",
    "e2e": "playwright test",
    "e2e:electron": "playwright test --project=electron",
    "e2e:install": "playwright install chromium firefox"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@dagrejs/dagre": "^3.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-html-community": "^0.0.8",
    "axios": "^1.6.7",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "idb": "^8.0.3",
    "js-cookie": "^3.0.5",
    "katex": "^0.16.45",
    "lucide-react": "^1.8.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-virtuoso": "^4.18.7",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "web-vitals": "^5.3.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/dompurify": "^3.0.5",
    "@types/js-cookie": "^3.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^25.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-legacy": "^8.2.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.0",
    "electron": "^43.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.58.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "terser": "^5.46.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
